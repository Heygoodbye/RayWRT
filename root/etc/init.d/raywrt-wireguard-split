#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=11

start_service() {
  [ "$(uci -q get raywrt.wireguard_split.enabled 2>/dev/null || echo 0)" = 1 ] || return 0
  procd_open_instance
  procd_set_param command /usr/libexec/raywrt-wireguard-split daemon
  procd_set_param respawn 3600 5 5
  procd_close_instance
}

stop_service() {
  /usr/libexec/raywrt-wireguard-split cleanup >/dev/null 2>&1 || true
}
